{
  "rules": {
    ".read": false,
    ".write": false,
    "notices": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'teacher@japanchonsan.app'",
      "$id": {
        ".validate": "newData.hasChildren(['title', 'time']) && newData.child('title').isString() && newData.child('title').val().length <= 500 && (!newData.child('body').exists() || (newData.child('body').isString() && newData.child('body').val().length <= 5000))"
      }
    },
    "assembly": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'teacher@japanchonsan.app'",
      ".validate": "newData.hasChildren(['targetTime', 'place']) && newData.child('place').isString() && newData.child('place').val().length <= 200 && (!newData.child('id').exists() || (newData.child('id').isString() && newData.child('id').val().length <= 40))"
    },
    "assign": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'teacher@japanchonsan.app'",
      ".validate": "newData.hasChildren(['json']) && newData.child('json').isString() && newData.child('json').val().length <= 100000"
    },
    "groupConfig": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'teacher@japanchonsan.app'",
      ".validate": "newData.hasChildren(['json']) && newData.child('json').isString() && newData.child('json').val().length <= 100000"
    },
    "checks": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'teacher@japanchonsan.app'"
    },
    "status": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'teacher@japanchonsan.app'",
      "$name": {
        ".write": true,
        ".validate": "$name.length <= 200 && newData.hasChildren(['name'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "grade": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "attendance": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "checklist": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "mission": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "essential": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "chats": {
      "$room": {
        ".read": "$room !== 'teachers' || (auth != null && auth.token.email === 'teacher@japanchonsan.app')",
        ".write": "auth != null && auth.token.email === 'teacher@japanchonsan.app'",
        "$msg": {
          ".write": "$room !== 'teachers' && !data.exists() && newData.exists() && root.child('chatSettings').child($room).child('teachersOnly').val() !== true",
          ".validate": "($room === 'all' || $room === 'g1' || $room === 'g2' || $room === 'teachers') && newData.hasChildren(['name', 'role', 'text', 'ts']) && newData.child('ts').val() === now && (newData.child('role').val() === 'student' || (newData.child('role').val() === 'teacher' && auth != null && auth.token.email === 'teacher@japanchonsan.app'))",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "role": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "grade": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "chatSettings": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'teacher@japanchonsan.app'",
      "$room": {
        ".validate": "$room === 'all' || $room === 'g1' || $room === 'g2'",
        "teachersOnly": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rollcall": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'teacher@japanchonsan.app'",
      "$aid": {
        "$name": {
          ".validate": "newData.hasChildren(['s', 'ts']) && (newData.child('s').val() === 'ok' || newData.child('s').val() === 'special')",
          "s": {
            ".validate": "newData.isString()"
          },
          "r": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "arrivals": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'teacher@japanchonsan.app'",
      "$aid": {
        "$name": {
          ".write": "$aid === root.child('assembly').child('id').val()",
          ".validate": "newData.isNumber() && newData.val() === now && $name.length <= 200"
        }
      }
    },
    "noticeAcks": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'teacher@japanchonsan.app'",
      "$nid": {
        "$name": {
          ".write": "root.child('notices').child($nid).child('ack').val() === true",
          ".validate": "newData.isNumber() && newData.val() === now && $name.length <= 200"
        }
      }
    },
    "teacherMemos": {
      ".read": "auth != null && auth.token.email === 'teacher@japanchonsan.app'",
      ".write": "auth != null && auth.token.email === 'teacher@japanchonsan.app'",
      "$key": {
        ".validate": "newData.isString() && newData.val().length <= 1000"
      }
    },
    "assemblyHistory": {
      ".read": "auth != null && auth.token.email === 'teacher@japanchonsan.app'",
      ".write": "auth != null && auth.token.email === 'teacher@japanchonsan.app'"
    },
    "groupRounds": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'teacher@japanchonsan.app'",
      "$rid": {
        ".validate": "newData.hasChildren(['cat', 'start', 'deadline']) && newData.child('start').isNumber() && newData.child('deadline').isNumber()"
      }
    },
    "groupChecks": {
      ".read": "auth != null && auth.token.email === 'teacher@japanchonsan.app'",
      ".write": "auth != null && auth.token.email === 'teacher@japanchonsan.app'",
      "$rid": {
        "$g": {
          ".write": "root.child('groupRounds').child($rid).exists()",
          ".validate": "newData.hasChildren(['by', 'ts', 'img']) && newData.child('ts').val() === now && newData.child('by').isString() && newData.child('by').val().length <= 20 && newData.child('img').isString() && newData.child('img').val().length <= 400000"
        }
      }
    },
    "groupCheckStatus": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'teacher@japanchonsan.app'",
      "$rid": {
        "$g": {
          ".write": "root.child('groupRounds').child($rid).exists()",
          ".validate": "newData.hasChildren(['by', 'ts']) && (auth != null && auth.token.email === 'teacher@japanchonsan.app' || (newData.child('ts').val() === now && !newData.child('state').exists()))"
        }
      }
    },
    "jeju": {
      "keys": {
        ".read": "auth != null && auth.token.email === 'teacher@japanchonsan.app'",
        ".write": "auth != null && auth.token.email === 'teacher@japanchonsan.app'",
        "$code": {
          ".validate": "$code.matches(/^[A-Z0-9]{6,20}$/) && newData.isBoolean()"
        }
      },
      "s": {
        "$code": {
          ".read": "root.child('jeju').child('keys').child($code).val() === true",
          ".write": "auth != null && auth.token.email === 'teacher@japanchonsan.app'",
          "meta": {
            "created": {
              ".validate": "newData.isNumber()"
            },
            "driveUrl": {
              ".validate": "newData.isString() && newData.val().beginsWith('https://') && newData.val().length <= 500"
            },
            "teacherTel": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9+() -]{3,20}$/)"
            },
            "$other": {
              ".validate": false
            }
          },
          "notices": {
            "$id": {
              ".validate": "newData.hasChildren(['text', 'ts'])",
              "text": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1000"
              },
              "level": {
                ".validate": "newData.val() === 'info' || newData.val() === 'important'"
              },
              "ts": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "gather": {
            ".validate": "newData.hasChildren(['id', 'date', 'time', 'place'])",
            "id": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{1,30}$/)"
            },
            "date": {
              ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)"
            },
            "time": {
              ".validate": "newData.isString() && newData.val().matches(/^\\d{2}:\\d{2}$/)"
            },
            "place": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
            },
            "label": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "ts": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          "arrivals": {
            "$gid": {
              "$name": {
                ".write": "root.child('jeju').child('keys').child($code).val() === true && root.child('jeju').child('s').child($code).child('gather').child('id').val() === $gid",
                ".validate": "$name.length <= 12 && newData.isNumber() && newData.val() === now"
              }
            }
          },
          "answers": {
            "$name": {
              "$mid": {
                ".write": "root.child('jeju').child('keys').child($code).val() === true",
                ".validate": "$name.length <= 12 && $mid.length <= 40 && newData.isString() && newData.val().length <= 1000"
              }
            }
          },
          "reflections": {
            "$name": {
              "$day": {
                ".write": "root.child('jeju').child('keys').child($code).val() === true",
                ".validate": "$name.length <= 12 && $day.matches(/^d[1-4]$/) && newData.isString() && newData.val().length <= 500"
              }
            }
          },
          "shots": {
            "$name": {
              "$sid": {
                ".write": "root.child('jeju').child('keys').child($code).val() === true",
                ".validate": "$name.length <= 12 && $sid.length <= 40 && newData.hasChildren()",
                "p": {
                  ".validate": "newData.isBoolean()"
                },
                "v": {
                  ".validate": "newData.isBoolean()"
                },
                "n": {
                  ".validate": "newData.isString() && newData.val().length <= 300"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "budgetAccess": {
        ".read": "auth != null && auth.token.email === 'teacher@japanchonsan.app'",
        ".write": "auth != null && auth.token.email === 'teacher@japanchonsan.app'",
        ".validate": "newData.hasChildren(['editorEmail'])",
        "editorEmail": {
          ".validate": "newData.isString() && newData.val().length <= 254 && newData.val().matches(/^[^@ ]+@[^@ ]+\\.[^@ ]+$/)"
        },
        "$other": {
          ".validate": false
        }
      },
      "budget": {
        ".read": "auth != null && (auth.token.email === 'teacher@japanchonsan.app' || (auth.token.email_verified === true && auth.token.email === root.child('jeju').child('budgetAccess').child('editorEmail').val()))",
        ".write": "auth != null && (auth.token.email === 'teacher@japanchonsan.app' || (auth.token.email_verified === true && auth.token.email === root.child('jeju').child('budgetAccess').child('editorEmail').val())) && newData.exists()",
        ".validate": "newData.hasChildren(['items', 'updatedAt', 'updatedBy']) && newData.child('items').hasChildren()",
        "items": {
          "$id": {
            ".validate": "$id.matches(/^item-([0-9]|[12][0-9])$/) && newData.hasChildren(['label', 'budget', 'approximate', 'order'])",
            "label": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            },
            "budget": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000 && newData.val() % 1 === 0"
            },
            "spent": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000 && newData.val() % 1 === 0"
            },
            "approximate": {
              ".validate": "newData.isBoolean()"
            },
            "order": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 30 && newData.val() % 1 === 0"
            },
            "note": {
              ".validate": "newData.isString() && newData.val().length <= 1000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "pending": {
          ".validate": "newData.isString() && newData.val().length <= 5000"
        },
        "excluded": {
          ".validate": "newData.isString() && newData.val().length <= 5000"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "updatedBy": {
          ".validate": "newData.val() === auth.uid"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
